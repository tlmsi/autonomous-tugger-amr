#!/usr/bin/env python3

import math

import rclpy
from rclpy.node import Node

from geometry_msgs.msg import TwistStamped
from std_msgs.msg import Float64MultiArray


class FourWSController(Node):

    def __init__(self):
        super().__init__('four_ws_controller')

        self.declare_parameter('wheelbase', 0.58)
        self.declare_parameter('track_width', 0.44)
        self.declare_parameter('wheel_radius', 0.055)
        self.declare_parameter('max_steering_angle', 0.7854)

        self.wheelbase = float(
            self.get_parameter('wheelbase').value
        )
        self.track_width = float(
            self.get_parameter('track_width').value
        )
        self.wheel_radius = float(
            self.get_parameter('wheel_radius').value
        )
        self.max_steering_angle = float(
            self.get_parameter('max_steering_angle').value
        )

        self.steering_pub = self.create_publisher(
            Float64MultiArray,
            '/steering_controller/commands',
            10
        )

        self.traction_pub = self.create_publisher(
            Float64MultiArray,
            '/traction_controller/commands',
            10
        )

        self.cmd_vel_sub = self.create_subscription(
            TwistStamped,
            '/cmd_vel',
            self.cmd_vel_callback,
            10
        )

        self.cmd_vel_timeout = 0.5
        self.last_cmd_vel_time = None
        self.watchdog_triggered = False

        self.watchdog_timer = self.create_timer(
            0.1,
            self.watchdog_callback
        )

        self.get_logger().info(
            '4WS linked-axle controller started '
            f'(L={self.wheelbase:.3f} m, '
            f'W={self.track_width:.3f} m, '
            f'Rwheel={self.wheel_radius:.3f} m)'
        )

    def clamp_steering(self, angle):
        return max(
            -self.max_steering_angle,
            min(self.max_steering_angle, angle)
        )

    def stop(self):
        steering_msg = Float64MultiArray()
        steering_msg.data = [0.0, 0.0, 0.0, 0.0]

        traction_msg = Float64MultiArray()
        traction_msg.data = [0.0, 0.0]

        self.steering_pub.publish(steering_msg)
        self.traction_pub.publish(traction_msg)

    def watchdog_callback(self):
        if self.last_cmd_vel_time is None:
            return

        elapsed = (
            self.get_clock().now() - self.last_cmd_vel_time
        ).nanoseconds / 1e9

        if elapsed >= self.cmd_vel_timeout and not self.watchdog_triggered:
            self.stop()
            self.watchdog_triggered = True

            self.get_logger().warning(
                f'cmd_vel timeout ({elapsed:.2f} s) - vehicle stopped'
            )

    def cmd_vel_callback(self, msg):

        self.last_cmd_vel_time = self.get_clock().now()
        self.watchdog_triggered = False

        v = float(msg.twist.linear.x)
        omega = float(msg.twist.angular.z)

        # No rotate-in-place capability.
        if abs(v) < 1e-4:
            self.stop()
            return

        # Straight driving.
        if abs(omega) < 1e-4:
            wheel_speed = v / self.wheel_radius

            steering_msg = Float64MultiArray()
            steering_msg.data = [
                0.0,  # FL
                0.0,  # FR
                0.0,  # RL
                0.0   # RR
            ]

            traction_msg = Float64MultiArray()
            traction_msg.data = [
                wheel_speed,  # RL
                wheel_speed   # RR
            ]

            self.steering_pub.publish(steering_msg)
            self.traction_pub.publish(traction_msg)
            return

        # ----------------------------------------------------------
        # LINKED-AXLE SYMMETRIC COUNTER-PHASE 4WS
        #
        # One steering command per axle:
        #
        #   FL = FR = +delta
        #   RL = RR = -delta
        #
        # For symmetric counter-phase 4WS:
        #
        #   omega / v = 2*tan(delta) / L
        #
        # therefore:
        #
        #   delta = atan(L*omega / (2*v))
        # ----------------------------------------------------------

        delta = math.atan2(
            self.wheelbase * omega,
            2.0 * v
        )

        # A steering direction is equivalent modulo pi.
        # Keep the mechanical steering command within +/- 90 degrees,
        # especially for reverse driving.
        while delta > math.pi / 2.0:
            delta -= math.pi

        while delta < -math.pi / 2.0:
            delta += math.pi

        delta = self.clamp_steering(delta)

        front_angle = delta
        rear_angle = -delta

        # ----------------------------------------------------------
        # REAR TRACTION SPEEDS
        #
        # Steering is mechanically linked per axle, but the two rear
        # traction motors remain independent.
        #
        # Use the commanded body yaw rate to account for the different
        # longitudinal velocities at the left/right wheel positions:
        #
        #   vx_i = v - omega*y_i
        #
        # RL: y = +W/2
        # RR: y = -W/2
        #
        # Convert longitudinal component into rolling speed along the
        # common rear steering direction.
        # ----------------------------------------------------------

        cos_rear = math.cos(rear_angle)

        if abs(cos_rear) < 1e-6:
            self.stop()
            return

        rear_left_linear = (
            v - omega * (0.5 * self.track_width)
        ) / cos_rear

        rear_right_linear = (
            v + omega * (0.5 * self.track_width)
        ) / cos_rear

        rear_left_speed = (
            rear_left_linear / self.wheel_radius
        )

        rear_right_speed = (
            rear_right_linear / self.wheel_radius
        )

        steering_msg = Float64MultiArray()
        steering_msg.data = [
            front_angle,  # FL
            front_angle,  # FR
            rear_angle,   # RL
            rear_angle    # RR
        ]

        traction_msg = Float64MultiArray()
        traction_msg.data = [
            rear_left_speed,
            rear_right_speed
        ]

        self.steering_pub.publish(steering_msg)
        self.traction_pub.publish(traction_msg)


def main(args=None):
    rclpy.init(args=args)

    node = FourWSController()

    try:
        rclpy.spin(node)
    except KeyboardInterrupt:
        pass
    finally:
        node.destroy_node()
        rclpy.shutdown()


if __name__ == '__main__':
    main()
