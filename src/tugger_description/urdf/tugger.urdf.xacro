<?xml version="1.0"?>

<robot xmlns:xacro="http://www.ros.org/wiki/xacro"
       name="autonomous_tugger">

  <!-- VEHICLE PARAMETERS -->

  <xacro:property name="body_length" value="0.90"/>
  <xacro:property name="body_width" value="0.60"/>

  <xacro:property name="wheelbase" value="0.58"/>
  <xacro:property name="wheel_y" value="0.22"/>

  <xacro:property name="wheel_radius" value="0.055"/>
  <xacro:property name="wheel_width" value="0.040"/>
  <xacro:property name="wheel_mass" value="1.0"/>

  <xacro:property name="chassis_mass" value="45.0"/>


  <!-- MATERIALS -->

  <material name="body_white">
    <color rgba="0.95 0.95 0.95 1.0"/>
  </material>

  <material name="black">
    <color rgba="0.02 0.02 0.02 1.0"/>
  </material>

  <material name="gap_dark">
    <color rgba="0.06 0.06 0.06 1.0"/>
  </material>

  <material name="sensor_red">
    <color rgba="0.85 0.02 0.02 1.0"/>
  </material>

  <material name="camera_black">
    <color rgba="0.005 0.005 0.005 1.0"/>
  </material>


  <!-- BASE FOOTPRINT -->

  <link name="base_footprint"/>

  <joint name="base_footprint_joint"
         type="fixed">

    <parent link="base_footprint"/>
    <child link="base_link"/>

    <origin xyz="0 0 0.100"
            rpy="0 0 0"/>

  </joint>


  <!-- MAIN BODY -->

  <link name="base_link">


    <!-- LOWER WHITE FILLETED LAYER -->

    <visual name="bottom_layer">

      <origin xyz="0 0 0"
              rpy="0 0 0"/>

      <geometry>
        <mesh filename="package://tugger_description/meshes/filleted_body.stl"/>
      </geometry>

      <material name="body_white"/>

    </visual>


    <!-- SMALL RECESSED DARK GAP -->

    <visual name="middle_gap">

      <origin xyz="0 0 0.0475"
              rpy="0 0 0"/>

      <geometry>
        <mesh filename="package://tugger_description/meshes/filleted_middle.stl"/>
      </geometry>

      <material name="gap_dark"/>

    </visual>


    <!-- UPPER WHITE FILLETED LAYER -->

    <visual name="top_layer">

      <origin xyz="0 0 0.095"
              rpy="0 0 0"/>

      <geometry>
        <mesh filename="package://tugger_description/meshes/filleted_body.stl"/>
      </geometry>

      <material name="body_white"/>

    </visual>


    <!-- SIMPLE COLLISION -->

    <collision>

      <origin xyz="0 0 0.0475"
              rpy="0 0 0"/>

      <geometry>
        <box size="0.88 0.58 0.15"/>
      </geometry>

    </collision>


    <inertial>

      <origin xyz="0 0 0.0475"
              rpy="0 0 0"/>

      <mass value="${chassis_mass}"/>

      <inertia
        ixx="1.25"
        ixy="0"
        ixz="0"
        iyy="2.90"
        iyz="0"
        izz="3.70"/>

    </inertial>

  </link>


  <!-- STEERED WHEEL MACRO -->

  <xacro:macro name="steered_wheel"
               params="prefix x y">

    <link name="${prefix}_steering_link">

      <inertial>

        <mass value="0.3"/>

        <inertia
          ixx="0.0005"
          ixy="0"
          ixz="0"
          iyy="0.0005"
          iyz="0"
          izz="0.0005"/>

      </inertial>

    </link>


    <joint name="${prefix}_steering_joint"
           type="revolute">

      <parent link="base_link"/>
      <child link="${prefix}_steering_link"/>

      <origin xyz="${x} ${y} -0.045"
              rpy="0 0 0"/>

      <axis xyz="0 0 1"/>

      <limit
        lower="-0.7854"
        upper="0.7854"
        effort="500"
        velocity="1.5"/>

    </joint>


    <link name="${prefix}_wheel_link">

      <visual>

        <origin xyz="0 0 0"
                rpy="1.5708 0 0"/>

        <geometry>
          <cylinder
            radius="${wheel_radius}"
            length="${wheel_width}"/>
        </geometry>

        <material name="black"/>

      </visual>


      <collision>

        <origin xyz="0 0 0"
                rpy="1.5708 0 0"/>

        <geometry>
          <cylinder
            radius="${wheel_radius}"
            length="${wheel_width}"/>
        </geometry>

      </collision>


      <inertial>

        <mass value="${wheel_mass}"/>

        <inertia
          ixx="${(1.0/12.0) * wheel_mass *
                 (3*wheel_radius*wheel_radius +
                  wheel_width*wheel_width)}"
          ixy="0"
          ixz="0"
          iyy="${0.5 * wheel_mass *
                 wheel_radius*wheel_radius}"
          iyz="0"
          izz="${(1.0/12.0) * wheel_mass *
                 (3*wheel_radius*wheel_radius +
                  wheel_width*wheel_width)}"/>

      </inertial>

    </link>


    <joint name="${prefix}_wheel_joint"
           type="continuous">

      <parent link="${prefix}_steering_link"/>
      <child link="${prefix}_wheel_link"/>

      <origin xyz="0 0 0"
              rpy="0 0 0"/>

      <axis xyz="0 1 0"/>

    </joint>

  </xacro:macro>


  <!-- GAZEBO WHEEL CONTACT / FRICTION -->

  <xacro:macro name="wheel_gazebo_friction" params="prefix">

    <gazebo reference="${prefix}_wheel_link">

      <mu1>1.0</mu1>
      <mu2>0.20</mu2>

      <fdir1>1 0 0</fdir1>


    </gazebo>

  </xacro:macro>


  <xacro:wheel_gazebo_friction prefix="front_left"/>
  <xacro:wheel_gazebo_friction prefix="front_right"/>
  <xacro:wheel_gazebo_friction prefix="rear_left"/>
  <xacro:wheel_gazebo_friction prefix="rear_right"/>



  <!-- FOUR-WHEEL STEERING -->

  <xacro:steered_wheel
    prefix="front_left"
    x="${wheelbase/2}"
    y="${wheel_y}"/>

  <xacro:steered_wheel
    prefix="front_right"
    x="${wheelbase/2}"
    y="${-wheel_y}"/>

  <xacro:steered_wheel
    prefix="rear_left"
    x="${-wheelbase/2}"
    y="${wheel_y}"/>

  <xacro:steered_wheel
    prefix="rear_right"
    x="${-wheelbase/2}"
    y="${-wheel_y}"/>


  <!-- FRONT-LEFT HEMISPHERICAL LIDAR -->

  <link name="front_left_lidar_link">

    <visual>

      <geometry>
        <sphere radius="0.040"/>
      </geometry>

      <material name="sensor_red"/>

    </visual>


    <inertial>

      <mass value="0.15"/>

      <inertia
        ixx="0.0001"
        ixy="0"
        ixz="0"
        iyy="0.0001"
        iyz="0"
        izz="0.0001"/>

    </inertial>

  </link>


  <joint name="front_left_lidar_joint"
         type="fixed">

    <parent link="base_link"/>
    <child link="front_left_lidar_link"/>

    <origin xyz="0.410 0.260 0.0275"
            rpy="0 0 0"/>

  </joint>


  <!-- REAR-RIGHT HEMISPHERICAL LIDAR -->

  <link name="rear_right_lidar_link">

    <visual>

      <geometry>
        <sphere radius="0.040"/>
      </geometry>

      <material name="sensor_red"/>

    </visual>


    <inertial>

      <mass value="0.15"/>

      <inertia
        ixx="0.0001"
        ixy="0"
        ixz="0"
        iyy="0.0001"
        iyz="0"
        izz="0.0001"/>

    </inertial>

  </link>


  <joint name="rear_right_lidar_joint"
         type="fixed">

    <parent link="base_link"/>
    <child link="rear_right_lidar_link"/>

    <origin xyz="-0.410 -0.260 0.0275"
            rpy="0 0 0"/>

  </joint>


  <!-- GAZEBO LIDAR SENSORS -->

  <gazebo reference="front_left_lidar_link">
    <sensor name="front_left_lidar_sensor" type="gpu_lidar">
      <always_on>true</always_on>
      <update_rate>15</update_rate>
      <topic>front_left/scan</topic>
      <gz_frame_id>front_left_lidar_link</gz_frame_id>

      <lidar>
        <scan>
          <horizontal>
            <samples>720</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159265</min_angle>
            <max_angle>3.14159265</max_angle>
          </horizontal>
        </scan>

        <range>
          <min>0.08</min>
          <max>20.0</max>
          <resolution>0.01</resolution>
        </range>
      </lidar>
    </sensor>
  </gazebo>

  <gazebo reference="rear_right_lidar_link">
    <sensor name="rear_right_lidar_sensor" type="gpu_lidar">
      <always_on>true</always_on>
      <update_rate>15</update_rate>
      <topic>rear_right/scan</topic>
      <gz_frame_id>rear_right_lidar_link</gz_frame_id>

      <lidar>
        <scan>
          <horizontal>
            <samples>720</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159265</min_angle>
            <max_angle>3.14159265</max_angle>
          </horizontal>
        </scan>

        <range>
          <min>0.08</min>
          <max>20.0</max>
          <resolution>0.01</resolution>
        </range>
      </lidar>
    </sensor>
  </gazebo>


  <!-- FRONT CAMERA -->

  <link name="front_camera_link">

    <visual>

      <geometry>
        <box size="0.005 0.080 0.025"/>
      </geometry>

      <material name="camera_black"/>

    </visual>


    <inertial>

      <mass value="0.10"/>

      <inertia
        ixx="0.0001"
        ixy="0"
        ixz="0"
        iyy="0.0001"
        iyz="0"
        izz="0.0001"/>

    </inertial>

  </link>


  <joint name="front_camera_joint"
         type="fixed">

    <parent link="base_link"/>
    <child link="front_camera_link"/>

    <origin xyz="0.460 0 0.095"
            rpy="0 0 0"/>

  </joint>


  <!-- REAR CAMERA -->

  <link name="rear_camera_link">

    <visual>

      <geometry>
        <box size="0.005 0.080 0.025"/>
      </geometry>

      <material name="camera_black"/>

    </visual>


    <inertial>

      <mass value="0.10"/>

      <inertia
        ixx="0.0001"
        ixy="0"
        ixz="0"
        iyy="0.0001"
        iyz="0"
        izz="0.0001"/>

    </inertial>

  </link>


  <joint name="rear_camera_joint"
         type="fixed">

    <parent link="base_link"/>
    <child link="rear_camera_link"/>

    <origin xyz="-0.460 0 0.095"
            rpy="0 0 3.14159"/>

  </joint>


  <!-- IMU -->

  <link name="imu_link"/>

  <joint name="imu_joint"
         type="fixed">

    <parent link="base_link"/>
    <child link="imu_link"/>

    <origin xyz="0 0 0"
            rpy="0 0 0"/>

  </joint>


  <!-- GAZEBO IMU SENSOR -->

  <gazebo reference="imu_link">
    <sensor name="imu_sensor" type="imu">
      <always_on>true</always_on>
      <update_rate>100</update_rate>
      <topic>imu</topic>
    <gz_frame_id>imu_link</gz_frame_id>
      <imu>
        <angular_velocity>
          <x>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>0.0002</stddev>
            </noise>
          </x>
          <y>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>0.0002</stddev>
            </noise>
          </y>
          <z>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>0.0002</stddev>
            </noise>
          </z>
        </angular_velocity>

        <linear_acceleration>
          <x>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>0.01</stddev>
            </noise>
          </x>
          <y>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>0.01</stddev>
            </noise>
          </y>
          <z>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>0.01</stddev>
            </noise>
          </z>
        </linear_acceleration>
      </imu>
    </sensor>
  </gazebo>


  <!-- HITCH -->

  <link name="hitch_link"/>

  <joint name="hitch_joint"
         type="fixed">

    <parent link="base_link"/>
    <child link="hitch_link"/>

    <origin xyz="-0.48 0 -0.02"
            rpy="0 0 0"/>

  </joint>



  <!-- LIFTING PLATFORM -->

  <link name="lift_platform_link">

    <visual>
      <geometry>
        <box size="0.50 0.32 0.015"/>
      </geometry>

      <material name="gap_dark"/>
    </visual>


    <collision>
      <geometry>
        <box size="0.50 0.32 0.015"/>
      </geometry>
    </collision>


    <inertial>
      <mass value="3.0"/>

      <inertia
        ixx="0.02566"
        ixy="0"
        ixz="0"
        iyy="0.06256"
        iyz="0"
        izz="0.08810"/>
    </inertial>

  </link>


  <joint name="lift_joint"
         type="prismatic">

    <parent link="base_link"/>
    <child link="lift_platform_link"/>

    <!--
      Lowered position:
      upper body top = 0.1225 m
      platform thickness = 0.015 m
      platform center = 0.1300 m
    -->

    <origin xyz="0 0 0.130"
            rpy="0 0 0"/>

    <axis xyz="0 0 1"/>

    <limit
      lower="0.0"
      upper="0.040"
      effort="2000"
      velocity="0.05"/>

  </joint>


  <!-- ROS 2 CONTROL -->

  <ros2_control name="GazeboSimSystem" type="system">

    <hardware>
      <plugin>gz_ros2_control/GazeboSimSystem</plugin>
    </hardware>

    <joint name="front_left_steering_joint">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <joint name="front_right_steering_joint">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <joint name="rear_left_steering_joint">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <joint name="rear_right_steering_joint">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>


    <!-- Rear-wheel-drive traction interfaces -->

    <joint name="rear_left_wheel_joint">
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <joint name="rear_right_wheel_joint">
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

  </ros2_control>


  <!-- GAZEBO ROS 2 CONTROL -->

  <gazebo>

    <plugin
      filename="gz_ros2_control-system"
      name="gz_ros2_control::GazeboSimROS2ControlPlugin">

      <parameters>$(find tugger_gazebo)/config/controllers.yaml</parameters>

    </plugin>

  </gazebo>

</robot>
