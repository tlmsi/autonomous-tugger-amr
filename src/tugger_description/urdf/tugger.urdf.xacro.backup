<?xml version="1.0"?>

<robot xmlns:xacro="http://www.ros.org/wiki/xacro"
       name="autonomous_tugger">

  <!-- ========================================================= -->
  <!--                    VEHICLE PARAMETERS                     -->
  <!-- ========================================================= -->

  <xacro:property name="chassis_length" value="0.80"/>
  <xacro:property name="chassis_width"  value="0.60"/>
  <xacro:property name="chassis_height" value="0.25"/>
  <xacro:property name="chassis_mass"   value="45.0"/>

  <!-- Distance between front and rear axles -->
  <xacro:property name="wheelbase" value="0.60"/>

  <!-- Lateral position of wheel centers -->
  <xacro:property name="wheel_y" value="0.33"/>

  <xacro:property name="wheel_radius" value="0.10"/>
  <xacro:property name="wheel_width"  value="0.06"/>
  <xacro:property name="wheel_mass"   value="2.0"/>

  <!-- ========================================================= -->
  <!--                        MATERIALS                          -->
  <!-- ========================================================= -->

  <material name="blue">
    <color rgba="0.08 0.25 0.55 1.0"/>
  </material>

  <material name="dark_grey">
    <color rgba="0.12 0.12 0.12 1.0"/>
  </material>

  <material name="black">
    <color rgba="0.02 0.02 0.02 1.0"/>
  </material>

  <!-- ========================================================= -->
  <!--                     BASE FOOTPRINT                        -->
  <!-- ========================================================= -->

  <link name="base_footprint"/>

  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 0.225" rpy="0 0 0"/>
  </joint>

  <!-- ========================================================= -->
  <!--                       BASE LINK                           -->
  <!-- ========================================================= -->

  <link name="base_link">

    <visual>
      <geometry>
        <box size="${chassis_length}
                   ${chassis_width}
                   ${chassis_height}"/>
      </geometry>
      <material name="blue"/>
    </visual>

    <collision>
      <geometry>
        <box size="${chassis_length}
                   ${chassis_width}
                   ${chassis_height}"/>
      </geometry>
    </collision>

    <inertial>
      <mass value="${chassis_mass}"/>

      <inertia
        ixx="${(1.0/12.0) * chassis_mass *
              (chassis_width*chassis_width +
               chassis_height*chassis_height)}"

        ixy="0"
        ixz="0"

        iyy="${(1.0/12.0) * chassis_mass *
              (chassis_length*chassis_length +
               chassis_height*chassis_height)}"

        iyz="0"

        izz="${(1.0/12.0) * chassis_mass *
              (chassis_length*chassis_length +
               chassis_width*chassis_width)}"/>
    </inertial>

  </link>

  <!-- ========================================================= -->
  <!--                    STEERING KNUCKLE                       -->
  <!-- ========================================================= -->

  <xacro:macro name="steered_wheel"
               params="prefix x y driven">

    <!--
      This link represents the steering knuckle / wheel carrier.
      It rotates about Z for steering.
    -->

    <link name="${prefix}_steering_link">

      <inertial>
        <mass value="0.5"/>
        <inertia
          ixx="0.001"
          ixy="0"
          ixz="0"
          iyy="0.001"
          iyz="0"
          izz="0.001"/>
      </inertial>

    </link>

    <!-- Steering DOF -->

    <joint name="${prefix}_steering_joint"
           type="revolute">

      <parent link="base_link"/>
      <child link="${prefix}_steering_link"/>

      <origin xyz="${x} ${y} -0.125"
              rpy="0 0 0"/>

      <axis xyz="0 0 1"/>

      <limit
        lower="-0.7854"
        upper="0.7854"
        effort="500"
        velocity="1.5"/>

    </joint>

    <!-- Wheel -->

    <link name="${prefix}_wheel_link">

      <visual>

        <origin rpy="1.5708 0 0"/>

        <geometry>
          <cylinder
            radius="${wheel_radius}"
            length="${wheel_width}"/>
        </geometry>

        <material name="black"/>

      </visual>

      <collision>

        <origin rpy="1.5708 0 0"/>

        <geometry>
          <cylinder
            radius="${wheel_radius}"
            length="${wheel_width}"/>
        </geometry>

      </collision>

      <inertial>

        <mass value="${wheel_mass}"/>

        <inertia
          ixx="${(1.0/12.0) * wheel_mass *
                 (3*wheel_radius*wheel_radius +
                  wheel_width*wheel_width)}"

          ixy="0"
          ixz="0"

          iyy="${0.5 * wheel_mass *
                 wheel_radius*wheel_radius}"

          iyz="0"

          izz="${(1.0/12.0) * wheel_mass *
                 (3*wheel_radius*wheel_radius +
                  wheel_width*wheel_width)}"/>

      </inertial>

    </link>

    <!-- Wheel rotation DOF -->

    <joint name="${prefix}_wheel_joint"
           type="continuous">

      <parent link="${prefix}_steering_link"/>
      <child link="${prefix}_wheel_link"/>

      <origin xyz="0 0 0"
              rpy="0 0 0"/>

      <axis xyz="0 1 0"/>

    </joint>

  </xacro:macro>

  <!-- ========================================================= -->
  <!--                     FRONT AXLE                            -->
  <!-- ========================================================= -->

  <xacro:steered_wheel
    prefix="front_left"
    x="${wheelbase/2}"
    y="${wheel_y}"
    driven="false"/>

  <xacro:steered_wheel
    prefix="front_right"
    x="${wheelbase/2}"
    y="${-wheel_y}"
    driven="false"/>

  <!-- ========================================================= -->
  <!--                      REAR AXLE                            -->
  <!-- ========================================================= -->

  <xacro:steered_wheel
    prefix="rear_left"
    x="${-wheelbase/2}"
    y="${wheel_y}"
    driven="true"/>

  <xacro:steered_wheel
    prefix="rear_right"
    x="${-wheelbase/2}"
    y="${-wheel_y}"
    driven="true"/>

  <!-- ========================================================= -->
  <!--                         LIDAR                             -->
  <!-- ========================================================= -->

  <link name="lidar_link">

    <visual>
      <geometry>
        <cylinder radius="0.055"
                  length="0.06"/>
      </geometry>
      <material name="dark_grey"/>
    </visual>

    <collision>
      <geometry>
        <cylinder radius="0.055"
                  length="0.06"/>
      </geometry>
    </collision>

    <inertial>
      <mass value="0.3"/>
      <inertia
        ixx="0.0002"
        ixy="0"
        ixz="0"
        iyy="0.0002"
        iyz="0"
        izz="0.0002"/>
    </inertial>

  </link>

  <joint name="lidar_joint"
         type="fixed">

    <parent link="base_link"/>
    <child link="lidar_link"/>

    <origin xyz="0.20 0 0.185"
            rpy="0 0 0"/>

  </joint>

  <!-- ========================================================= -->
  <!--                          IMU                              -->
  <!-- ========================================================= -->

  <link name="imu_link"/>

  <joint name="imu_joint"
         type="fixed">

    <parent link="base_link"/>
    <child link="imu_link"/>

    <origin xyz="0 0 0"
            rpy="0 0 0"/>

  </joint>

  <!-- ========================================================= -->
  <!--                         HITCH                             -->
  <!-- ========================================================= -->

  <link name="hitch_link"/>

  <joint name="hitch_joint"
         type="fixed">

    <parent link="base_link"/>
    <child link="hitch_link"/>

    <origin xyz="-0.45 0 -0.02"
            rpy="0 0 0"/>

  </joint>

</robot>
