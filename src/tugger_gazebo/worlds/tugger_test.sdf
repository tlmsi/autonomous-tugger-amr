<?xml version="1.0" ?>

<sdf version="1.10">

  <world name="tugger_test">

    <physics name="physics" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin
      filename="gz-sim-physics-system"
      name="gz::sim::systems::Physics"/>

    <plugin
      filename="gz-sim-user-commands-system"
      name="gz::sim::systems::UserCommands"/>

    <plugin
      filename="gz-sim-scene-broadcaster-system"
      name="gz::sim::systems::SceneBroadcaster"/>

    <plugin
      filename="gz-sim-sensors-system"
      name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <plugin
      filename="gz-sim-imu-system"
      name="gz::sim::systems::Imu"/>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>

      <link name="link">

        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>

          <material>
            <ambient>0.35 0.35 0.35 1</ambient>
            <diffuse>0.45 0.45 0.45 1</diffuse>
            <specular>0.10 0.10 0.10 1</specular>
          </material>

        </visual>

      </link>
    </model>

    <!-- ==========================================================
         TEMPORARY SLAM / NAV2 TEST ARENA
         6 m x 6 m enclosed area centered around world origin.
         Remove/replace during Milestone 12 industrial environment.
         ========================================================== -->

    <!-- North wall -->
    <model name="nav_test_wall_north">
      <static>true</static>
      <pose>0 3.0 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box><size>6.0 0.10 1.0</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>6.0 0.10 1.0</size></box>
          </geometry>
        </visual>
      </link>
    </model>

    <!-- South wall -->
    <model name="nav_test_wall_south">
      <static>true</static>
      <pose>0 -3.0 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box><size>6.0 0.10 1.0</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>6.0 0.10 1.0</size></box>
          </geometry>
        </visual>
      </link>
    </model>

    <!-- East wall -->
    <model name="nav_test_wall_east">
      <static>true</static>
      <pose>3.0 0 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box><size>0.10 6.0 1.0</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>0.10 6.0 1.0</size></box>
          </geometry>
        </visual>
      </link>
    </model>

    <!-- West wall -->
    <model name="nav_test_wall_west">
      <static>true</static>
      <pose>-3.0 0 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box><size>0.10 6.0 1.0</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>0.10 6.0 1.0</size></box>
          </geometry>
        </visual>
      </link>
    </model>

    <!-- Internal obstacle 1 -->
    <model name="nav_test_obstacle_1">
      <static>true</static>
      <pose>1.5 1.3 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box><size>0.6 0.6 1.0</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>0.6 0.6 1.0</size></box>
          </geometry>
        </visual>
      </link>
    </model>

    <!-- Internal obstacle 2 -->
    <model name="nav_test_obstacle_2">
      <static>true</static>
      <pose>-1.3 -1.5 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box><size>0.8 0.5 1.0</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>0.8 0.5 1.0</size></box>
          </geometry>
        </visual>
      </link>
    </model>


  </world>

</sdf>
