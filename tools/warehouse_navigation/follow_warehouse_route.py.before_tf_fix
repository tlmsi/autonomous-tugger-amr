#!/usr/bin/env python3

import argparse
import json
import math
import sys
import time
from pathlib import Path

import rclpy
from rclpy.node import Node
from rclpy.action import ActionClient
from rclpy.duration import Duration

from geometry_msgs.msg import PoseStamped
from nav_msgs.msg import Path as NavPath
from nav2_msgs.action import FollowPath
from tf2_ros import Buffer, TransformListener, TransformException


def normalize(angle):
    return math.atan2(math.sin(angle), math.cos(angle))


def yaw_to_quaternion(yaw):
    return math.sin(yaw / 2), math.cos(yaw / 2)


def quaternion_to_yaw(q):
    return math.atan2(
        2 * (q.w * q.z + q.x * q.y),
        1 - 2 * (q.y * q.y + q.z * q.z)
    )


class WarehouseRouteExecutor(Node):

    def __init__(self, args):
        super().__init__("warehouse_route_executor")

        self.args = args

        self.publisher = self.create_publisher(
            NavPath,
            "/warehouse/planned_path",
            10
        )

        self.tf_buffer = Buffer()
        self.tf_listener = TransformListener(
            self.tf_buffer,
            self
        )

        self.client = ActionClient(
            self,
            FollowPath,
            "/follow_path"
        )

        data = json.loads(Path(args.route).read_text())

        route = data.get("selected_route")

        if route is None:
            raise RuntimeError("Route JSON contains no valid route")

        self.direction = route.get(
            "direction",
            data.get("driving_direction", "forward")
        )

        self.route_poses = route["poses"]

        if len(self.route_poses) < 2:
            raise RuntimeError("Route requires at least two poses")

        self.path = NavPath()
        self.path.header.frame_id = args.frame

        for x, y, yaw in self.route_poses:
            p = PoseStamped()
            p.header.frame_id = args.frame

            p.pose.position.x = float(x)
            p.pose.position.y = float(y)

            qz, qw = yaw_to_quaternion(float(yaw))
            p.pose.orientation.z = qz
            p.pose.orientation.w = qw

            self.path.poses.append(p)

        self.timer = self.create_timer(
            0.5,
            self.publish_path
        )

    def publish_path(self):
        stamp = self.get_clock().now().to_msg()
        self.path.header.stamp = stamp

        for p in self.path.poses:
            p.header.stamp = stamp

        self.publisher.publish(self.path)

    def get_robot_pose(self):
        transform = self.tf_buffer.lookup_transform(
            self.args.frame,
            self.args.base_frame,
            rclpy.time.Time(),
            timeout=Duration(seconds=1.0)
        )

        p = transform.transform.translation
        q = transform.transform.rotation

        return p.x, p.y, quaternion_to_yaw(q)

    def check_start(self):
        try:
            x, y, yaw = self.get_robot_pose()

        except TransformException as exc:
            print(f"\nTF unavailable: {exc}")
            return False

        sx, sy, syaw = self.route_poses[0]

        distance = math.hypot(x - sx, y - sy)
        heading_error = abs(normalize(yaw - syaw))

        print("\n========== START ALIGNMENT ==========")
        print(
            f"Robot: x={x:.3f}, y={y:.3f}, "
            f"yaw={math.degrees(yaw):.1f} deg"
        )
        print(
            f"Route: x={sx:.3f}, y={sy:.3f}, "
            f"yaw={math.degrees(syaw):.1f} deg"
        )
        print(f"Position error: {distance:.3f} m")
        print(
            "Heading error:",
            f"{math.degrees(heading_error):.1f} deg"
        )

        aligned = (
            distance <= self.args.position_tolerance
            and heading_error <= math.radians(
                self.args.heading_tolerance
            )
        )

        print("Alignment:", "PASS" if aligned else "FAIL")

        return aligned

    def execute(self):
        print("\nWaiting for Nav2 FollowPath action...")

        if not self.client.wait_for_server(timeout_sec=10.0):
            print("ERROR: /follow_path action unavailable")
            return

        if not self.check_start():
            print("ERROR: Robot is not aligned with route start.")
            print("No motion command was sent.")
            return

        goal = FollowPath.Goal()
        goal.path = self.path

        # Use Nav2's configured controller and goal checker.
        # Empty IDs select the server defaults when supported.
        goal.controller_id = ""
        goal.goal_checker_id = ""

        print("\nSending FollowPath goal...")

        future = self.client.send_goal_async(goal)

        rclpy.spin_until_future_complete(self, future)
        handle = future.result()

        if handle is None or not handle.accepted:
            print("FollowPath goal rejected")
            return

        print("FollowPath goal accepted")

        result_future = handle.get_result_async()

        try:
            rclpy.spin_until_future_complete(
                self,
                result_future
            )
            result = result_future.result()

            print("FollowPath status:", result.status)
            print("FollowPath result:", result.result)

        except KeyboardInterrupt:
            print("\nCancelling FollowPath...")
            cancel_future = handle.cancel_goal_async()
            rclpy.spin_until_future_complete(
                self,
                cancel_future,
                timeout_sec=3.0
            )
            raise


def main():
    parser = argparse.ArgumentParser()

    parser.add_argument("--route", required=True)
    parser.add_argument("--frame", default="map")
    parser.add_argument("--base-frame", default="base_link")
    parser.add_argument("--execute", action="store_true")

    parser.add_argument(
        "--position-tolerance",
        type=float,
        default=0.30
    )

    parser.add_argument(
        "--heading-tolerance",
        type=float,
        default=15.0
    )

    args = parser.parse_args()

    rclpy.init()

    node = None

    try:
        node = WarehouseRouteExecutor(args)

        print("\n========== WAREHOUSE ROUTE ==========")
        print("Route:", args.route)
        print("Frame:", args.frame)
        print("Direction:", node.direction)
        print("Number of poses:", len(node.route_poses))
        print("Execution requested:", args.execute)

        # Allow TF subscriptions to receive transforms.
        deadline = time.monotonic() + 8.0

        while time.monotonic() < deadline:
            rclpy.spin_once(node, timeout_sec=0.1)

            try:
                node.get_robot_pose()
                break
            except TransformException:
                pass

        if args.execute:
            node.execute()
        else:
            node.check_start()

            print("\nDRY RUN ONLY — no motion commands sent.")
            print("Publishing /warehouse/planned_path")
            print("Press Ctrl+C to exit.")

            while rclpy.ok():
                rclpy.spin_once(node, timeout_sec=0.2)

    except KeyboardInterrupt:
        print("\nStopped.")

    finally:
        if node is not None:
            node.destroy_node()

        if rclpy.ok():
            rclpy.shutdown()


if __name__ == "__main__":
    main()
